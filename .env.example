# ── AgentCrew — Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in real values before running docker compose up
# NEVER commit .env to git

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=production

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=change_me_minio_user
MINIO_SECRET_KEY=change_me_minio_password_min_8_chars

# ── CORS (comma-separated, no trailing slash) ──────────────────────────────────
CORS_ORIGINS=https://crew.korvuz.sit,http://127.0.0.1:8790

# ── Clerk (get from clerk.com dashboard) ──────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...
# Dashboard → API Keys → Advanced → JWT public key → JWKS URL
# Usually: https://<instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# ── Fernet master key for API key vault ───────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=

# ── Frontend → Backend proxy (Docker internal URL) ────────────────────────────
# Used by Next.js rewrites to forward /api/* requests to FastAPI
# Do not change unless you rename the backend Docker service
BACKEND_URL=http://backend:8000

# ── LLM provider API keys (B4 — CrewAI runner reads these via LiteLLM) ───────
# Set at least one; agents pick the first available provider they're configured for
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-proj-...
